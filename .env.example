# Copy to .env.local to run the site against a different Supabase project, such as the test one. .env.local is ignored by git.
# With neither value set, the site uses the production project. Set both or neither.
# Both values are safe to publish: the key only allows what the database's row level security allows.
# Restart the dev server after adding or removing the file.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=sb_publishable_your-key
